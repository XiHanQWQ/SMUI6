<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SMUI.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SMUI/Styles/Theme.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentBrush" Color="#7CC540" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#8FD94F" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#6AAD35" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

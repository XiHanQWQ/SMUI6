<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMUI.App.ViewModels"
             x:Class="SMUI.App.Views.UpdatesPage"
             x:DataType="vm:UpdatesPageViewModel">

    <Design.DataContext>
        <vm:UpdatesPageViewModel/>
    </Design.DataContext>

    <!-- ============ 检查更新（复刻原版 UiTabControl2 三步骤子选项卡） ============ -->
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <StackPanel x:Name="StepNav" Orientation="Horizontal" Spacing="2" Margin="10,6">
                <RadioButton Classes="leftNav" Width="150" Content="步骤一 发送数据" GroupName="steps" IsChecked="True" />
                <RadioButton Classes="leftNav" Width="150" Content="步骤二 选择返回数据" GroupName="steps" />
                <RadioButton Classes="leftNav" Width="150" Content="步骤三 在本地找到项" GroupName="steps" />
            </StackPanel>
        </Border>

        <Panel Grid.Row="1">
            <!-- ======== 步骤一：发送数据到 smapi.io ======== -->
            <ScrollViewer x:Name="Step1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="步骤一：发送数据到 smapi.io" FontSize="17" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Classes="dim" LineHeight="20"
                               Text="此步骤会把当前子库中所有模组项的 UniqueID、更新键与已安装版本号发送到 SMAPI 官方云服务（smapi.io），批量查询每个模组的最新版本与兼容性信息。数据仅用于查询，不会被存储。&#x0a;检查完成后到「步骤二」查看返回的更新建议，再到「步骤三」定位本地模组项并执行更新。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Content="开始检查全部更新" Command="{Binding CheckAllUpdatesCommand}" />
                        <TextBlock Text="{Binding BusyText}" Classes="dim" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Classes="dim"
                               Text="提示：smapi.io 云检查不需要 API Key；后续的 NEXUS 下载更新需要在「设置 → 在线服务」中配置 NEXUS API Key。" />
                </StackPanel>
            </ScrollViewer>

            <!-- ======== 步骤二：选择返回数据 ======== -->
            <Grid x:Name="Step2" RowDefinitions="Auto,*,Auto" Margin="14,12" IsVisible="False">
                <TextBlock Grid.Row="0" Text="步骤二：选择返回数据（检查结果列表）" FontWeight="Bold" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                         Background="#202020" BorderBrush="#2E2E2E" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpdateResultVm">
                            <Grid ColumnDefinitions="*,190,150" Margin="2,4" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UniqueId}" FontSize="10.5" Classes="dim" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Compatibility}" FontSize="11" Classes="dim"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Classes="tool" Content="← 回到步骤一 重新检查" Command="{Binding CheckAllUpdatesCommand}" />
                    <TextBlock Text="在列表中选中一个结果后，到「步骤三」执行更新。" Classes="dim" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ======== 步骤三：在本地找到项 ======== -->
            <ScrollViewer x:Name="Step3" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                <StackPanel Margin="24,20" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="步骤三：在本地找到项并运行更新" FontSize="17" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Classes="dim" LineHeight="20"
                               Text="选中「步骤二」中的一个结果后，选择下方按钮执行更新。更新内容会下载到指定的本地模组项中，压缩包自动解压。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Content="N网更新（NEXUS）" Command="{Binding RunNexusUpdateCommand}" />
                        <Button Classes="tool" Content="GitHub 更新" Command="{Binding RunGitHubUpdateCommand}" />
                        <Button Classes="tool" Content="打开 ModDrop 页面" Command="{Binding OpenModDropPageCommand}" />
                        <Button Classes="tool" Content="打开建议链接" Command="{Binding OpenSuggestedUrlCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Classes="dim"
                               Text="ModDrop 需要浏览器登录账户，因此打开网页手动下载后，再把压缩包放入模组项（管理模组 → 项内容 → 添加文件）。" />
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>

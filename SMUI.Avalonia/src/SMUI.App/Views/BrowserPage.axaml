<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SMUI.App.Views.BrowserPage">

    <Grid RowDefinitions="Auto,*" Margin="0">
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,5"
                BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="AddressBox" Height="28" Watermark="输入网址" KeyDown="AddressBox_KeyDown" />
                <Button Grid.Column="1" Classes="tool" Content="前往" Click="Go_Click" />
                <Button Grid.Column="2" Classes="tool" Content="↗ 外部打开" Click="OpenExternal_Click" />
            </Grid>
        </Border>
        <Panel Grid.Row="1" Background="{DynamicResource WindowBgBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
                <TextBlock Text="内置浏览器" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Text="输入网址后点击【前往】在系统浏览器中打开。&#x0a;内置浏览器功能将在后续版本中加入。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Classes="tool" Content="NEXUS" Click="OpenNexus_Click" />
                    <Button Classes="tool" Content="SMAPI" Click="OpenSmapi_Click" />
                    <Button Classes="tool" Content="ModDrop" Click="OpenModDrop_Click" />
                </StackPanel>
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="using:WebView.Avalonia"
             x:Class="SMUI.App.Views.BrowserPage">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="8,5"
                BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox x:Name="AddressBox" Height="28" Watermark="输入网址" KeyDown="AddressBox_KeyDown" />
                <Button Grid.Column="1" Classes="tool" Content="前往" Click="Go_Click" />
                <Button Grid.Column="2" Classes="tool" Content="⟳" Click="Reload_Click" />
                <Button Grid.Column="3" Classes="tool" Content="↗ 外部打开" Click="OpenExternal_Click" />
            </Grid>
        </Border>
        <Panel Grid.Row="1" x:Name="BrowserHost" />
    </Grid>
</UserControl>

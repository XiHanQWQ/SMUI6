<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMUI.App.ViewModels"
             xmlns:v="using:SMUI.App.Views"
             x:Class="SMUI.App.Views.ModsPage"
             x:DataType="vm:ModsPageViewModel">

    <Design.DataContext>
        <vm:ModsPageViewModel/>
    </Design.DataContext>

    <!-- ============ 管理模组（复刻原版三栏 + 底部信息条） ============ -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 工具条（复刻 Panel5/Panel6） -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,5"
                BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <Button Classes="tool" Content="分类和子库菜单">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="刷新数据子库" Command="{Binding LoadCommand}" />
                                <MenuItem Header="新建数据子库" Command="{Binding NewSubLibraryCommand}" />
                                <MenuItem Header="删除当前子库" Command="{Binding DeleteSubLibraryCommand}" />
                                <Separator />
                                <MenuItem Header="新建分类" Command="{Binding NewCategoryCommand}" />
                                <MenuItem Header="重命名分类" Command="{Binding RenameCategoryCommand}" />
                                <MenuItem Header="删除分类" Command="{Binding DeleteCategoryCommand}" />
                                <MenuItem Header="设置分类颜色" Command="{Binding SetCategoryColorCommand}" />
                                <MenuItem Header="设置分类字体" Command="{Binding SetCategoryFontCommand}" />
                                <Separator />
                                <MenuItem Header="分类上移" Command="{Binding MoveCategoryUpCommand}" />
                                <MenuItem Header="分类下移" Command="{Binding MoveCategoryDownCommand}" />
                                <MenuItem Header="打开分类文件夹" Command="{Binding OpenCategoryFolderCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Text="{Binding CategoryCountText}" Classes="dim" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ItemCountText}" Classes="dim" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 三栏内容 -->
        <Grid Grid.Row="1" ColumnDefinitions="250,7,*,7,310">

            <!-- 分类（Panel2） -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
                <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" Margin="10,8"
                         SelectedItem="{Binding SelectedCategory}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryVm">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{Binding ColorBrush}"
                                       FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开分类文件夹" Command="{Binding OpenCategoryFolderCommand}" />
                            <MenuItem Header="重命名分类" Command="{Binding RenameCategoryCommand}" />
                            <Separator />
                            <MenuItem Header="设置分类颜色" Command="{Binding SetCategoryColorCommand}" />
                            <MenuItem Header="设置分类字体" Command="{Binding SetCategoryFontCommand}" />
                            <Separator />
                            <MenuItem Header="分类上移" Command="{Binding MoveCategoryUpCommand}" />
                            <MenuItem Header="分类下移" Command="{Binding MoveCategoryDownCommand}" />
                            <Separator />
                            <MenuItem Header="刷新分类" Command="{Binding LoadCategoriesCommand}" />
                            <MenuItem Header="删除分类" Command="{Binding DeleteCategoryCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- 模组项列表（Panel4） -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,5"
                        BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Classes="tool" Content="模组项菜单">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="安装 (F5)" Command="{Binding InstallSelectedCommand}" />
                                        <MenuItem Header="卸载 (F6)" Command="{Binding UninstallSelectedCommand}" />
                                        <Separator />
                                        <MenuItem Header="新建项" Command="{Binding NewItemCommand}" />
                                        <MenuItem Header="批量创建项..." Command="{Binding BatchCreateItemsCommand}" />
                                        <MenuItem Header="重命名项" Command="{Binding RenameItemCommand}" />
                                        <MenuItem Header="删除项" Command="{Binding DeleteItemsCommand}" />
                                        <MenuItem Header="设置项字体" Command="{Binding SetItemFontCommand}" />
                                        <MenuItem Header="清除 Config 缓存" Command="{Binding ClearConfigCacheCommand}" />
                                        <Separator />
                                        <MenuItem Header="全局模组安装检查（从游戏 Mods 导入）..." Command="{Binding ImportFromGameModsCommand}" />
                                        <MenuItem Header="下载并新建项..." Command="{Binding DownloadAndCreateItemCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="tool" Content="⟳ 刷新" Command="{Binding RefreshItemsCommand}" />
                            <Button x:Name="BtnFullSearch" Classes="tool" Content="🔍 全库搜索" />
                            <TextBox Text="{Binding SearchText}" Watermark="搜索模组..." Width="170" Height="28" />
                            <ComboBox MinWidth="100" SelectedIndex="{Binding StatusFilterIndex}" Height="28">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="已安装" />
                                <ComboBoxItem Content="未安装" />
                                <ComboBoxItem Content="更新可用" />
                                <ComboBoxItem Content="全库已安装" />
                                <ComboBoxItem Content="全库未安装" />
                            </ComboBox>
                            <Button Classes="tool" Content="虚拟组" Command="{Binding FilterByVirtualGroupCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="tool" Content="导入/导出">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="导出数据子库 (.smuispak)" Command="{Binding ExportSubLibraryCommand}" />
                                        <MenuItem Header="导出分类 (.smuicpak)" Command="{Binding ExportCategoryCommand}" />
                                        <MenuItem Header="导出选中项 (.smuimpak)" Command="{Binding ExportItemsCommand}" />
                                        <Separator />
                                        <MenuItem Header="导入数据子库" Command="{Binding ImportSubLibraryCommand}" />
                                        <MenuItem Header="导入分类" Command="{Binding ImportCategoryCommand}" />
                                        <MenuItem Header="导入模组项" Command="{Binding ImportItemsCommand}" />
                                        <Separator />
                                        <MenuItem Header="加入导出预设" Command="{Binding AddToPresetCommand}" />
                                        <MenuItem Header="批量导出预设..." Command="{Binding ExportPresetCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="tool" Content="更多操作">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="配置项（加入配置队列）" Command="{Binding AddToQueueCommand}" />
                                        <MenuItem Header="虚拟组管理" Command="{Binding ManageVirtualGroupsCommand}" />
                                        <Separator />
                                        <MenuItem Header="从 Mods 覆盖到数据库（本地更新）" Command="{Binding UpdateItemOverwriteCommand}" />
                                        <MenuItem Header="从 Mods 替换到数据库（本地更新·全量）" Command="{Binding UpdateItemReplaceCommand}" />
                                        <Separator />
                                        <MenuItem Header="N网更新选中项" Command="{Binding NexusUpdateCommand}" />
                                        <MenuItem Header="GitHub 更新选中项" Command="{Binding GitHubUpdateCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="{Binding SelectionCountText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                            <Button Classes="accent" Content="安装 F5" Command="{Binding InstallSelectedCommand}" />
                            <Button Classes="danger" Content="卸载 F6" Command="{Binding UninstallSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="ItemsList" ItemsSource="{Binding FilteredItems}"
                         SelectionMode="Multiple" Margin="8,6" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModItemVm">
                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="{Binding FontWeight}"
                                               FontStyle="{Binding FontStyle}" TextDecorations="{Binding Decorations}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GroupsText}" FontSize="10.5" Classes="dim"
                                               IsVisible="{Binding GroupsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11.5" Classes="dim" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5" Margin="10,0,0,0"
                                           Foreground="{Binding StatusColorKey, Converter={x:Static v:StatusColorConverter.Instance}}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="安装 (F5)" Command="{Binding InstallSelectedCommand}" />
                            <MenuItem Header="卸载 (F6)" Command="{Binding UninstallSelectedCommand}" />
                            <Separator />
                            <MenuItem Header="配置项（加入配置队列）" Command="{Binding AddToQueueCommand}" />
                            <MenuItem Header="打开项文件夹" Command="{Binding OpenItemFolderCommand}" />
                            <MenuItem Header="重命名项" Command="{Binding RenameItemCommand}" />
                            <MenuItem Header="删除项" Command="{Binding DeleteItemsCommand}" />
                            <Separator />
                            <MenuItem Header="从 Mods 覆盖到数据库（本地更新）" Command="{Binding UpdateItemOverwriteCommand}" />
                            <MenuItem Header="从 Mods 替换到数据库（本地更新·全量）" Command="{Binding UpdateItemReplaceCommand}" />
                            <Separator />
                            <MenuItem Header="N网更新选中项" Command="{Binding NexusUpdateCommand}" />
                            <MenuItem Header="GitHub 更新选中项" Command="{Binding GitHubUpdateCommand}" />
                            <Separator />
                            <MenuItem Header="虚拟组管理" Command="{Binding ManageVirtualGroupsCommand}" />
                            <MenuItem Header="加入导出预设" Command="{Binding AddToPresetCommand}" />
                            <MenuItem Header="设置项字体" Command="{Binding SetItemFontCommand}" />
                            <MenuItem Header="清除 Config 缓存" Command="{Binding ClearConfigCacheCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="3" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- 详情侧栏（Panel3） -->
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="#2E2E2E" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,5" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="描述" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DetailSourceTag}" Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,8" Spacing="10">
                            <TextBlock Text="{Binding DetailName}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding DetailVersion}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                <TextBlock FontSize="12" Classes="dim" IsVisible="{Binding HasVersionDifference}">
                                    <Run Text="已装 " /><Run Text="{Binding DetailInstalledVersion}" />
                                </TextBlock>
                            </StackPanel>
                            <Border ClipToBounds="True" IsVisible="{Binding HasPreview}"
                                    Background="#232323" MinHeight="100" MaxHeight="200">
                                <Panel>
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                    <Border Background="#AA000000" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                        <TextBlock Text="{Binding PreviewCounter}" FontSize="10.5" />
                                    </Border>
                                </Panel>
                            </Border>
                            <Border Background="#232323" BorderBrush="#2E2E2E" BorderThickness="1" Padding="10,8" MaxHeight="240">
                                <ScrollViewer>
                                    <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 版本对比条（复刻 Panel8） -->
                    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="10,6"
                            BorderBrush="#2E2E2E" BorderThickness="0,1,0,0" IsVisible="{Binding HasVersionDifference}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock FontSize="12">
                                <Run Text="仓库版本 " Foreground="#00BFFF" /><Run Text="{Binding DetailVersion}" Foreground="#00BFFF" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock FontSize="12">
                                <Run Text="已装版本 " Foreground="#32CD32" /><Run Text="{Binding DetailInstalledVersion}" Foreground="#32CD32" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 项信息按钮条（复刻 Panel1） -->
                    <Border Grid.Row="3" Background="{DynamicResource ToolbarBrush}" Padding="8,4"
                            BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="tool" x:Name="BtnUpdateKeys" Content="更新键" FontSize="11.5" />
                            <Button Classes="tool" x:Name="BtnDeps" Content="依赖项表" FontSize="11.5" />
                            <Button Classes="tool" x:Name="BtnUniqueIds" Content="UniqueID 表" FontSize="11.5" />
                            <Button Classes="tool" x:Name="BtnAuthors" Content="作者表" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 全局忙提示条 -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}" Padding="10,4"
                BorderBrush="#2E2E2E" BorderThickness="0,1,0,0" IsVisible="{Binding IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BusyText}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SMUI.App.Views.DependenciesWindow"
        Title="依赖项表" Width="640" Height="440" CanResize="True"
        Background="#181818" Foreground="#E0E0E0" FontFamily="微软雅黑">
    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
        <TextBlock x:Name="ItemTitle" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Spacing="12" />
        </ScrollViewer>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" HorizontalAlignment="Right" MinWidth="86" />
    </Grid>
</Window>

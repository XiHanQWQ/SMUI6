<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMUI.App.ViewModels"
        xmlns:views="using:SMUI.App.Views"
        x:Class="SMUI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        FontFamily="微软雅黑"
        Title="SMUI 6"
        Width="1280" Height="800"
        MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- ============ 主选项卡条（复刻 UiTabControl1 + RUN SMAPI 按钮） + 页面内容 ============ -->
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel x:Name="NavPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton Classes="mainTab" Content="起始页面" GroupName="nav" IsChecked="True" />
                    <RadioButton Classes="mainTab" Content="管理模组" GroupName="nav" />
                    <RadioButton Classes="mainTab" Content="配置队列" GroupName="nav" />
                    <RadioButton Classes="mainTab" Content="下载更新" GroupName="nav" />
                    <RadioButton Classes="mainTab" Content="检查更新" GroupName="nav" />
                    <RadioButton Classes="mainTab" Content="浏览器" GroupName="nav" />
                    <RadioButton Classes="mainTab" Content="调试输出" GroupName="nav" />
                </StackPanel>

                <Button Grid.Column="1" Classes="accent" Content="RUN SMAPI" Command="{Binding Home.RunSmapiCommand}"
                        VerticalAlignment="Stretch" FontSize="15" FontWeight="Bold" Padding="28,0" />
            </Grid>
        </Border>

        <!-- ============ 页面内容 ============ -->
        <Panel Grid.Row="1">
            <views:HomePage x:Name="Page0" DataContext="{Binding Home}" />
            <views:ModsPage x:Name="Page1" DataContext="{Binding Mods}" />
            <views:QueuePage x:Name="Page2" DataContext="{Binding Queue}" />
            <views:DownloadsPage x:Name="Page3" DataContext="{Binding Updates}" />
            <views:UpdatesPage x:Name="Page4" DataContext="{Binding Updates}" />
            <views:BrowserPage x:Name="Page5" />
            <views:LogPage x:Name="Page6" DataContext="{Binding Log}" />
        </Panel>
    </Grid>
</Window>

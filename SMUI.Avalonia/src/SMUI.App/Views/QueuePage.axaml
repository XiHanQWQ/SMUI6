<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMUI.App.ViewModels"
             xmlns:v="using:SMUI.App.Views"
             x:Class="SMUI.App.Views.QueuePage"
             x:DataType="vm:QueuePageViewModel">

    <Design.DataContext>
        <vm:QueuePageViewModel/>
    </Design.DataContext>

    <!-- ============ 配置队列（一比一复刻 WinForms：双行工具栏 + 左队列/右规划） ============ -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 行1：设置项名称 [输入] 自定义版本号 [输入] …… 保存改动并移除 仅保存 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,6"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,10,Auto,160,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="设置项名称" VerticalAlignment="Center" FontSize="13.5" />
                <TextBox Grid.Column="1" Text="{Binding EditingName}" Height="28" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="3" Text="自定义版本号" VerticalAlignment="Center" FontSize="13.5" Margin="16,0,0,0" />
                <TextBox Grid.Column="4" Text="{Binding EditingVersion}" Height="28" VerticalContentAlignment="Center" />
                <Button Grid.Column="6" Classes="flat" Content="保存改动并移除" Command="{Binding SaveAndRemoveCommand}" />
                <Button Grid.Column="7" Classes="flat" Content="仅保存" Command="{Binding SaveItemCommand}" />
            </Grid>
        </Border>

        <!-- 行2：配置队列 打开目录 全部移除 移除选中 | 设置安装规划 自动规划 添加步骤 -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBrush}" Padding="10,2"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,3,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="配置队列" Classes="areaLabel" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="flat" Content="打开目录" Command="{Binding OpenItemDirectoryCommand}" />
                <Button Grid.Column="2" Classes="flat" Content="全部移除" Command="{Binding ClearQueueCommand}" />
                <Button Grid.Column="3" Classes="flat" Content="移除选中" Command="{Binding RemoveSelectedCommand}" />
                <TextBlock Grid.Column="5" Text="设置安装规划" Classes="areaLabel" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Button Grid.Column="7" Classes="flat" Content="自动规划" Command="{Binding AutoPlanCommand}" />
                <Button Grid.Column="10" Classes="flat" Content="添加步骤" Command="{Binding AddPlanCommand}" />
            </Grid>
        </Border>

        <!-- 主体：左（队列 + 项的数据内容） 47% | 右（规划列表） -->
        <Grid Grid.Row="2" ColumnDefinitions="47*,1,53*">

            <!-- 左：队列列表 + 项的数据内容 -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding QueueItems}" SelectedItem="{Binding SelectedQueueItem}"
                         Background="Transparent" Margin="0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueItemVm">
                            <StackPanel Margin="12,6" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category}" FontSize="10.5" Classes="dim" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="10,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="项的数据内容" Classes="areaLabel" VerticalAlignment="Center" />
                                <Button Classes="flat" Content="添加文件夹" Command="{Binding AddFolderCommand}" />
                                <Button Classes="flat" Content="添加文件" Command="{Binding AddFilesCommand}" />
                                <Button Classes="flat" Content="刷新" Command="{Binding RescanContentsCommand}" />
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="2" x:Name="ContentList" ItemsSource="{Binding Contents}" Height="190"
                                 Background="Transparent" Margin="0,2">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="删除选中" Command="{Binding DeleteContentsCommand}" />
                                    <MenuItem Header="解压压缩包" Command="{Binding ExtractArchiveCommand}" />
                                    <MenuItem Header="拿出内容" Command="{Binding UnNestCommand}" />
                                    <MenuItem Header="套层" Command="{Binding NestCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContentVm">
                                    <Grid ColumnDefinitions="*,Auto" Margin="12,4">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{Binding ColorKey, Converter={x:Static v:StatusColorConverter.Instance}}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="10" Classes="dim" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush1}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- 右：安装规划列表 -->
            <Border Grid.Column="2" Background="{DynamicResource WindowBgBrush}">
                <ListBox x:Name="PlanList" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                         Background="Transparent" Margin="0,4">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditPlanCommand}" />
                            <MenuItem Header="删除" Command="{Binding RemovePlanCommand}" />
                            <Separator />
                            <MenuItem Header="上移" Command="{Binding MovePlanUpCommand}" />
                            <MenuItem Header="下移" Command="{Binding MovePlanDownCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanStepVm">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                                <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding ValuePreview}" FontSize="12" Classes="dim"
                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>

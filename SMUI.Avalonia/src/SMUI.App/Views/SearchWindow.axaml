<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:SMUI.App.Views"
        x:Class="SMUI.App.Views.SearchWindow"
        Title="全库搜索" Width="820" Height="540" CanResize="True"
        Background="#181818" Foreground="#E0E0E0" FontFamily="微软雅黑">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
        <TextBox x:Name="KeywordBox" Watermark="输入关键字（项名 / 作者 / 描述 / UniqueID）" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10">
            <TextBlock Text="范围：" VerticalAlignment="Center" />
            <ComboBox x:Name="ScopeBox" SelectedIndex="1" MinWidth="130">
                <ComboBoxItem Content="当前分类" />
                <ComboBoxItem Content="当前子库" />
                <ComboBoxItem Content="全库" />
            </ComboBox>
            <Button x:Name="SearchButton" Content="搜索" MinWidth="90" />
            <TextBlock x:Name="SummaryText" Classes="dim" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox Grid.Row="2" x:Name="ResultList" Margin="0,10" DoubleTapped="OnResultDoubleTapped"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="v:SearchResultRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" Margin="2,4">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Location}" FontSize="10.5" Classes="dim"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11.5" Classes="dim"
                                   Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Classes="dim" FontSize="10.5"
                   Text="双击结果跳转到对应分类和项；搜索范围为项名 / 作者 / 描述 / UniqueID 的包含匹配。" />
    </Grid>
</Window>

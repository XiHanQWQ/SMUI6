<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMUI.App.ViewModels"
        x:Class="SMUI.App.Views.Dialogs.MultiSelectDialog"
        x:DataType="vm:MultiSelectDialogViewModel"
        Title="{Binding Title}"
        Width="480" MaxWidth="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
>
    <Design.DataContext>
        <vm:MultiSelectDialogViewModel/>
    </Design.DataContext>

    <Border Margin="1" CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
        <StackPanel Margin="22,18,22,20" Spacing="12">
            <TextBlock Text="{Binding Message}" Classes="dim" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="6" MaxHeight="300">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Selectable}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" Margin="4,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="全选" Command="{Binding SelectAllCommand}" Classes="tool" />
                <Button Content="反选" Command="{Binding InvertCommand}" Classes="tool" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="88" />
                <Button Content="确定" Command="{Binding OkCommand}" Classes="accent" MinWidth="88" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

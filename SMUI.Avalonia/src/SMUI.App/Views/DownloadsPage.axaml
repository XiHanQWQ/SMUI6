<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMUI.App.ViewModels"
             x:Class="SMUI.App.Views.DownloadsPage"
             x:DataType="vm:UpdatesPageViewModel">

    <Design.DataContext>
        <vm:UpdatesPageViewModel/>
    </Design.DataContext>

    <!-- ============ 下载更新（一比一复刻 WinForms：顶栏提示 + 左队列/右文件区） ============ -->
    <Grid RowDefinitions="Auto,*">

        <!-- 顶栏：选择要下载的文件 | 提示文字 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="14,12"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="26">
                <TextBlock Text="选择要下载的文件" Foreground="{DynamicResource AccentBrush}" FontSize="14.5"
                           FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="在管理模组选项卡中发起更新来获取文件列表" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 主体：左侧队列 23% | 右侧文件区 -->
        <Grid Grid.Row="1" ColumnDefinitions="23*,1,77*">

            <!-- 左：下载和更新队列 + NEXUS 下载模式 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="下载和更新队列" FontSize="14" Margin="14,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Downloads}" Background="Transparent" Margin="6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="2,5">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="✕" Command="{Binding CancelCommand}" FontSize="11" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding NexusModeText}" FontSize="14" Margin="14,10" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush1}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- 右：文件列表区（发起 NEXUS 更新后展示可选文件） -->
            <Panel Grid.Column="2" Background="{DynamicResource WindowBgBrush}">
                <ListBox ItemsSource="{Binding NexusFileOptions}" Background="Transparent" Margin="0,4"
                         SelectionMode="Multiple" x:Name="NexusFileList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,6" Spacing="2">
                                <TextBlock Text="{Binding Display}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Classes="dim" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Grid>
    </Grid>
</UserControl>

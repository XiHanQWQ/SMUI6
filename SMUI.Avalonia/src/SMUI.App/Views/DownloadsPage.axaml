<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMUI.App.ViewModels"
             x:Class="SMUI.App.Views.DownloadsPage"
             x:DataType="vm:UpdatesPageViewModel">

    <Design.DataContext>
        <vm:UpdatesPageViewModel/>
    </Design.DataContext>

    <!-- ============ 下载更新（复刻原版下载选项卡） ============ -->
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" Padding="12,8"
                BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="⬇ 下载并新建项..." Command="{Binding DownloadAndCreateItemCommand}" />
                <TextBlock Text="输入压缩包直链或选择本地压缩包，自动解压并生成安装规划" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="14,12">
            <TextBlock Grid.Row="0" Text="下载和更新队列" FontWeight="Bold" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Downloads}" Background="#202020" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,180,90,Auto" VerticalAlignment="Center" Margin="2,4">
                            <TextBlock Text="{Binding FileName}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" Height="6" Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="11" Classes="dim" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Classes="ghost" Content="✕" Command="{Binding CancelCommand}" FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Classes="dim" TextWrapping="Wrap"
                       Text="NEXUS 模组更新请在「检查更新」或「管理模组」中使用（需要 API Key）；此处队列显示所有进行中的下载任务，点击 ✕ 可取消。" />
        </Grid>
    </Grid>
</UserControl>

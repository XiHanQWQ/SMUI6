<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ SMUI 6 原版配色（WinForms SunnyUI 复刻） ============ -->

    <Styles.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818" />
        <SolidColorBrush x:Key="PanelBrush" Color="#202020" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="CardBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#404040" />
        <SolidColorBrush x:Key="CardPressedBrush" Color="#505050" />
        <SolidColorBrush x:Key="BorderBrush1" Color="#2E2E2E" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#3C3C3C" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#969696" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E6E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6EBE28" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#336EBE28" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#7ED236" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#5FA822" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF4500" />

        <SolidColorBrush x:Key="StatusWhiteBrush" Color="#DCDCDC" />
        <SolidColorBrush x:Key="StatusRedBrush" Color="#FF4500" />
        <SolidColorBrush x:Key="StatusOrangeBrush" Color="#FF8C00" />
        <SolidColorBrush x:Key="StatusYellowBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="StatusGreenBrush" Color="#32CD32" />
        <SolidColorBrush x:Key="StatusCyanBrush" Color="#00E6E6" />
        <SolidColorBrush x:Key="StatusBlueBrush" Color="#00BFFF" />
        <SolidColorBrush x:Key="StatusPurpleBrush" Color="#EE82EE" />
    </Styles.Resources>

    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#232323" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#282828" />
        <Setter Property="BorderBrush" Value="#4A4A4A" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="#232323" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        <Setter Property="BorderBrush" Value="#4A4A4A" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardPressedBrush}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#10140A" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#10140A" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#33FF4500" />
        <Setter Property="Foreground" Value="#FF8A78" />
        <Setter Property="BorderBrush" Value="#55FF4500" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55FF4500" />
        <Setter Property="Foreground" Value="#FFB0A2" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="29" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E2E" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A4A2A" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        <Setter Property="BorderBrush" Value="#4A4A4A" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#4A4A4A" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#PART_SwitchKnobBoundsOn">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="0" Background="#3C3C3C" Margin="2" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="0" Background="#4A4A4A" Margin="2" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="#232323" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="6" />
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="#232323" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="#3C3C3C" />
        <Setter Property="Margin" Value="6,3" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ============ 顶部主选项卡条（复刻 UiTabControlMenu，151x50） ============ -->
    <Style Selector="RadioButton.mainTab">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="130" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root" Background="Transparent" BorderThickness="0,3,0,0" BorderBrush="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.mainTab:pointerover /template/ Border#root">
        <Setter Property="Background" Value="#232323" />
    </Style>
    <Style Selector="RadioButton.mainTab:checked /template/ Border#root">
        <Setter Property="Background" Value="#202020" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.mainTab:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ============ 起始页左侧竖排菜单（复刻 UiTabControlMenu1，150x40） ============ -->
    <Style Selector="RadioButton.leftNav">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root" Background="#202020" BorderThickness="0" Padding="14,0">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.leftNav:pointerover /template/ Border#root">
        <Setter Property="Background" Value="#282828" />
    </Style>
    <Style Selector="RadioButton.leftNav:checked /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.leftNav:checked">
        <Setter Property="Foreground" Value="#10140A" />
    </Style>

    <!-- 窗口标题栏控制按钮 -->
    <Style Selector="Button.cap">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.cap:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.cap.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.tool">
        <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:SMUI.App.Views">

    <!-- ============ SMUI 配色：Catppuccin Mocha（Base #1E1E2E / Mantle #181825 / Surface #313244 / Blue #89B4FA） ============ -->

    <!-- ============ 全局（控件模板交给 Material.Avalonia，这里只做底色/字体） ============ -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
        <Setter Property="FontFamily" Value="微软雅黑" />
    </Style>
    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
    </Style>

    <!-- ============ 全局按钮前景（Material 默认前景在暗底上不可读，统一亮色） ============ -->
    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ============ 扁平文本按钮（WinForms 菜单栏按钮样式：白字无边框） ============ -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush1}" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardPressedBrush}" />
    </Style>
    <Style Selector="Button.flat.left">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.flat.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.flat.orange">
        <Setter Property="Foreground" Value="{DynamicResource LabelOrangeBrush}" />
    </Style>

    <!-- 次级描边按钮（对话框/弹窗用） -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardPressedBrush}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#11111B" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#33F38BA8" />
        <Setter Property="Foreground" Value="#F38BA8" />
        <Setter Property="BorderBrush" Value="#55F38BA8" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55F38BA8" />
        <Setter Property="Foreground" Value="#F8C9D4" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>

    <!-- 链接样式按钮（复刻原版 LinkLabel：默认无下划线，悬停下划线） -->
    <Style Selector="Button.linkBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.linkBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.linkBtn:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.linkBtn.dim">
        <Setter Property="Foreground" Value="Silver" />
    </Style>

    <!-- ============ 橙色栏目标签（配置队列/项的数据内容/设置安装规划…） ============ -->
    <Style Selector="TextBlock.areaLabel">
        <Setter Property="Foreground" Value="{DynamicResource LabelOrangeBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ============ 列表 ============ -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============ 主导航选项卡（复刻 UiTabControl1：等宽 + 底部蓝线） ============ -->
    <Style Selector="RadioButton.mainTab">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.mainTab:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="RadioButton.mainTab:checked /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.mainTab:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ============ 检查更新步骤选项卡（步骤一/二/三） ============ -->
    <Style Selector="RadioButton.stepTab">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                        Padding="16,0">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.stepTab:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="RadioButton.stepTab:checked /template/ Border#root">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.stepTab:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ============ 起始页左侧竖排菜单（复刻 UiTabControlMenu1，150x40） ============ -->
    <Style Selector="RadioButton.leftNav">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="root" Background="{DynamicResource PanelBrush}" BorderThickness="0" Padding="14,0">
                    <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.leftNav:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style Selector="RadioButton.leftNav:checked /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.leftNav:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ============ 紧凑菜单（复刻 WinForms 菜单：同背景色 / 带图标 / 13px 密度） ============ -->
    <Style Selector="ContextMenu">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- 覆盖 Material 的 48dp 大模板：复刻 WinForms 菜单密度的紧凑模板 -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_LayoutRoot" Background="Transparent" CornerRadius="3"
                            MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*,Auto,8" VerticalAlignment="Center">
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}" Width="16" Height="16"
                                              Margin="0,0,7,0"
                                              IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGesture}" Opacity="0.55"
                                       VerticalAlignment="Center" />
                            <Path Grid.Column="2" Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  IsVisible="{Binding Items, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static v:HasItemsConverter.Instance}}" />
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Right"
                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding $parent[MenuItem]}">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush1}"
                                BorderThickness="1" CornerRadius="5" Padding="2" Margin="6,0,8,8">
                            <ScrollViewer MaxHeight="620">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="MenuItem:open /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style Selector="MenuFlyout > Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="Margin" Value="2,2" />
    </Style>

    <!-- ============ TextBox：复刻 WinForms 带边框单行框（去 Material 下划线/装饰条） ============ -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel Margin="{TemplateBinding Padding}">
                        <TextBlock x:Name="PART_Watermark" DockPanel.Dock="Top"
                                   Text="{TemplateBinding Watermark}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"
                                   IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                   IsHitTestVisible="False" />
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="True">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           PasswordChar="{TemplateBinding PasswordChar}"
                                           RevealPassword="{TemplateBinding RevealPassword}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           TextAlignment="{TemplateBinding TextAlignment}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ============ 杂项 ============ -->
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush1}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
</Styles>
